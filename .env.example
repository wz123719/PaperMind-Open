# PaperMind backend model credential (never commit this file).
# Put your API key after the equals sign. Do not use a VITE_ prefix.
PAPERMIND_MODEL_API_KEY=

# In the workspace model settings:
# endpoint: your provider full Chat Completions URL
# model: your provider model ID
# key_env: PAPERMIND_MODEL_API_KEY
# Reading/chat/translation/glossary can share this variable if using the same key.
# Restart start-model-worker.ps1 after changing this file.
